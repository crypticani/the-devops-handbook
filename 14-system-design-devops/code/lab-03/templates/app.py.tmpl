"""${SERVICE_NAME} — generated by the platform golden path v${PLATFORM_VERSION}.

You get /healthz, /readyz and /metrics for free. Deleting them fails the policy gate,
which is deliberate: they are what makes this service operable by someone who did not write it.
"""
import os
import time

from flask import Flask, jsonify, request
from prometheus_client import CONTENT_TYPE_LATEST, Counter, Histogram, generate_latest

app = Flask(__name__)
SERVICE = "${SERVICE_NAME}"
OWNER = "${OWNER}"

REQUESTS = Counter("http_requests_total", "Requests", ["method", "path", "status"])
ERRORS = Counter("http_errors_total", "Errors", ["path"])
LATENCY = Histogram("http_request_duration_seconds", "Latency", ["path"],
                    buckets=[0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1, 2.5, 5])


@app.before_request
def _start():
    request.environ["_t0"] = time.time()


@app.after_request
def _record(response):
    LATENCY.labels(request.path).observe(time.time() - request.environ.get("_t0", time.time()))
    REQUESTS.labels(request.method, request.path, response.status_code).inc()
    if response.status_code >= 500:
        ERRORS.labels(request.path).inc()
    return response


def dependencies():
    """Replace with real checks — a connection pool, a cache ping, a required config key."""
    return {"config": bool(os.environ.get("APP_ENV"))}


@app.route("/healthz")
def healthz():
    # Liveness ONLY: is this process alive. Never check dependencies here, or one slow
    # database restarts your entire fleet.
    return jsonify({"status": "ok", "service": SERVICE})


@app.route("/readyz")
def readyz():
    # Readiness: can this instance serve right now. Check what serving actually requires.
    for name, healthy in dependencies().items():
        if not healthy:
            return jsonify({"status": "not ready", "failing": name}), 503
    return jsonify({"status": "ready"})


@app.route("/")
def index():
    return jsonify({"service": SERVICE, "owner": OWNER, "platform": "${PLATFORM_VERSION}"})


@app.route("/metrics")
def metrics():
    return generate_latest(), 200, {"Content-Type": CONTENT_TYPE_LATEST}


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=8080)
