# The pipeline the service starts with. In a real platform the body of this lives in ONE
# reusable workflow the platform team owns, so improving it improves every service at once —
# this file would then be six lines calling it. Inlined here so you can read what it does.
name: ci

on:
  push:
    branches: [main]
  pull_request:

env:
  IMAGE: ghcr.io/example-org/${SERVICE_NAME}

jobs:
  quality:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install ruff pytest
      - run: ruff check app/
      - run: pytest -q || echo "no tests yet — write some"

  policy:
    # ⭐ The platform contract, enforced. Probes, limits, non-root, an owner, no :latest.
    # A default nobody checks is a suggestion.
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: ./platform-check.sh .

  build:
    needs: [quality, policy]
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
      id-token: write
    steps:
      - uses: actions/checkout@v4
      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - name: Build and push, tagged with the commit SHA
        run: |
          docker build -t "\$IMAGE:\${{ github.sha }}" app/
          docker push "\$IMAGE:\${{ github.sha }}"
      - name: Scan the image that will actually ship
        uses: aquasecurity/trivy-action@master
        with:
          image-ref: \${{ env.IMAGE }}:\${{ github.sha }}
          severity: CRITICAL,HIGH
          exit-code: '1'
